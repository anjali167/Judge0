# Copy to .env and edit before `docker compose up`
JWT_SECRET=change-me-to-a-long-random-string
DB_PASSWORD=change-me
JUDGE0_DB_PASSWORD=change-me-too

# Public URLs (what browsers use). With the bundled Caddyfile on a domain:
#   PUBLIC_API_URL=https://your-domain/api
#   PUBLIC_WEB_URL=https://your-domain
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Judge workers per container (2 is right for ~1 GB free RAM; see runbook)
JUDGE_CONCURRENCY=2
